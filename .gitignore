# Python / FastAPI backend
# ----------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv/
venv/
backend/cache/
backend/__pycache__/

# Private keys of the GitHub App. Deliberately a pattern and not the one file
# name: a second machine uses a key of its own, whose name carries its own
# date of issue, and a named exception would leave it committable.
*.pem

