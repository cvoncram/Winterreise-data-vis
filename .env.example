# Local configuration for docker compose; copy to .env (not committed).
#
#   cp .env.example .env
#
# Unset values fall back to the defaults in docker-compose.yml.


# --- Private key of the GitHub App ------------------------------------------
#
# Path to your own key, generated under "Private keys" in the App settings.

# GITHUB_PRIVATE_KEY_FILE=./backend/my-key.private-key.pem


# --- App identifiers ---------------------------------------------------------
#
# Only for a different App or installation.

# GITHUB_APP_ID=2827092
# GITHUB_INSTALLATION_ID=108972344


# --- Frontend port -----------------------------------------------------------

# FRONTEND_PORT=3000
